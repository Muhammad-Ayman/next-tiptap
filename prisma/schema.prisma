generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int      @id
  title       String
  html        String   @db.Text
  json        Json
  cover       String
  author      String
  readingTime Int
  createdAt   String
  updatedAt   DateTime @updatedAt
}
